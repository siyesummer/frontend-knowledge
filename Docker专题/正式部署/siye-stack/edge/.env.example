# edge-nginx 只管理入口、静态首页、域名路由和 TLS。
EDGE_NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# 并行验证阶段只绑定回环地址，不占用宿主机 Nginx 的 80/443。
EDGE_HTTP_BIND_ADDRESS=127.0.0.1
EDGE_HTTP_HOST_PORT=18080
EDGE_HTTPS_BIND_ADDRESS=127.0.0.1
EDGE_HTTPS_HOST_PORT=18443

# 首轮 HTTP 使用 sites-http.conf；证书就绪后改成 sites-https.conf。
EDGE_NGINX_SITES_FILE=./nginx/sites-http.conf

# 当前公安部审核首页直接使用宿主机静态目录，只读挂载，不制作镜像。
SIYES_HOME_DIR=/var/www/siyes.cn

# 必须挂载整个目录，保证 live/ 证书软链接能够访问 archive/。
TLS_LETSENCRYPT_DIR=/etc/letsencrypt


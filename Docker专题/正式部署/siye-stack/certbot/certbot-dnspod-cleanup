#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="${DNSPOD_ENV_FILE:-/etc/letsencrypt/dnspod.env}"
STATE_DIR="/var/lib/letsencrypt/dnspod"

source "$ENV_FILE"

: "${DNSPOD_LOGIN_TOKEN:?DNSPOD_LOGIN_TOKEN is required}"
: "${DNSPOD_DOMAIN:?DNSPOD_DOMAIN is required}"
: "${CERTBOT_DOMAIN:?CERTBOT_DOMAIN is required}"
: "${CERTBOT_VALIDATION:?CERTBOT_VALIDATION is required}"

case "$CERTBOT_DOMAIN" in
  "$DNSPOD_DOMAIN"|"*.$DNSPOD_DOMAIN") ;;
  *)
    echo "[ERROR] Refusing DNS change for unexpected domain: $CERTBOT_DOMAIN" >&2
    exit 1
    ;;
esac

state_key="$(
  printf '%s' "$CERTBOT_VALIDATION" |
    sha256sum |
    awk '{print $1}'
)"
state_file="$STATE_DIR/$state_key.record-id"

if [ ! -f "$state_file" ]; then
  echo "[WARN] No DNSPod state file for $CERTBOT_DOMAIN; nothing to remove"
  exit 0
fi

record_id="$(cat "$state_file")"

response="$(
  curl --fail --silent --show-error \
    --request POST \
    --data-urlencode "login_token=$DNSPOD_LOGIN_TOKEN" \
    --data-urlencode "format=json" \
    --data-urlencode "domain=$DNSPOD_DOMAIN" \
    --data-urlencode "record_id=$record_id" \
    "https://dnsapi.cn/Record.Remove"
)"

printf '%s' "$response" |
  python3 -c '
import json
import sys

payload = json.load(sys.stdin)
status = payload.get("status", {})
code = str(status.get("code", ""))
message = status.get("message", "")

if code != "1":
    print(
        f"DNSPod Record.Remove failed: code={code} message={message}",
        file=sys.stderr,
    )
    raise SystemExit(1)
'

rm -f "$state_file"

echo "[OK] DNSPod TXT removed: record_id=$record_id domain=$CERTBOT_DOMAIN"

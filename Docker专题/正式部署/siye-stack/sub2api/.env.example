# Sub2API 独立配置。不会被 core、edge 或 svg-draw Compose 读取。
TZ=Asia/Shanghai

SUB2API_IMAGE=weishaw/sub2api@sha256:2ca591c2af97eb0e2797cfc7fb7bd587194d94cebdac76f73d677eeab1d4d6c8
POSTGRES_IMAGE=postgres@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15
REDIS_IMAGE=redis@sha256:9d317178eceac8454a2284a9e6df2466b93c745529947f0cd42a0fa9609d7005

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
POSTGRES_DB=sub2api
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_DB=0
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=10
REDIS_ENABLE_TLS=false

SUB2API_SERVER_MODE=release
SUB2API_RUN_MODE=standard
SUB2API_ADMIN_EMAIL=replace-with-real-admin-email
SUB2API_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
SUB2API_JWT_SECRET=replace-with-openssl-rand-hex-32
SUB2API_JWT_EXPIRE_HOUR=24
SUB2API_TOTP_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
SUB2API_SETUP_MIGRATION_TIMEOUT_SECONDS=0

SUB2API_GEMINI_OAUTH_CLIENT_ID=
SUB2API_GEMINI_OAUTH_CLIENT_SECRET=
SUB2API_GEMINI_OAUTH_SCOPES=
SUB2API_GEMINI_QUOTA_POLICY=
SUB2API_GEMINI_CLI_OAUTH_CLIENT_SECRET=
SUB2API_ANTIGRAVITY_OAUTH_CLIENT_SECRET=
SUB2API_ANTIGRAVITY_USER_AGENT_VERSION=

SUB2API_SECURITY_URL_ALLOWLIST_ENABLED=false
SUB2API_SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
SUB2API_SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
SUB2API_SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=
SUB2API_UPDATE_PROXY_URL=

SUB2API_GATEWAY_OPENAI_RESPONSE_HEADER_TIMEOUT=0
SUB2API_GATEWAY_OPENAI_HTTP2_ENABLED=true
SUB2API_GATEWAY_OPENAI_HTTP2_ALLOW_PROXY_FALLBACK_TO_HTTP1=true
SUB2API_GATEWAY_OPENAI_HTTP2_FALLBACK_ERROR_THRESHOLD=2
SUB2API_GATEWAY_OPENAI_HTTP2_FALLBACK_WINDOW_SECONDS=60
SUB2API_GATEWAY_OPENAI_HTTP2_FALLBACK_TTL_SECONDS=600
SUB2API_GATEWAY_IMAGE_STREAM_DATA_INTERVAL_TIMEOUT=900
SUB2API_GATEWAY_IMAGE_STREAM_KEEPALIVE_INTERVAL=10
SUB2API_GATEWAY_IMAGE_CONCURRENCY_ENABLED=false
SUB2API_GATEWAY_IMAGE_CONCURRENCY_MAX_CONCURRENT_REQUESTS=0
SUB2API_GATEWAY_IMAGE_CONCURRENCY_OVERFLOW_MODE=reject
SUB2API_GATEWAY_IMAGE_CONCURRENCY_WAIT_TIMEOUT_SECONDS=30
SUB2API_GATEWAY_IMAGE_CONCURRENCY_MAX_WAITING_REQUESTS=100


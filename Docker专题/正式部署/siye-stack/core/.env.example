# siyeWorld 业务核心栈配置。Sub2API、edge 和 svg-draw 使用各自目录的 .env。
TZ=Asia/Shanghai

SIYE_WORLD_IMAGE=siyesummer/siye-world:0.0.3
# 0.0.2 将包含 stdout/stderr 与生产文件日志双写能力，发布前不能启动正式 core。
MUSIC_API_IMAGE=siyesummer/music-api:0.0.2
LINUX_SERVER_IMAGE=siyesummer/linux-server:0.0.1
EASY_CHAT_IMAGE=siyesummer/easy-chat:0.0.2
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0.39

# 允许正式站点、Windows 历史站点、本地开发和 siyeWorld GitHub Pages。
# GitHub Pages 页面路径是 /siyeWorld/，但 CORS Origin 只能填写 https://siyesummer.github.io。
MUSIC_API_CORS_ALLOW_ORIGIN=https://music.siyes.cn,http://siyefun.top,http://music.siyefun.top,http://localhost:8080,https://siyesummer.github.io
LINUX_SERVER_CORS_ALLOW_ORIGINS=https://music.siyes.cn,http://siyefun.top,http://music.siyefun.top,http://localhost:8080,https://siyesummer.github.io
EASY_CHAT_CORS_ALLOW_ORIGIN=https://music.siyes.cn,http://siyefun.top,http://music.siyefun.top,http://localhost:8080,https://siyesummer.github.io

MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=siye_chat
MYSQL_USER=siye_chat_app
MYSQL_PASSWORD=replace-with-a-long-random-app-password

# Docker 正式日志使用独立宿主机目录，不和 systemd 的 /var/log/siye 混用。
SIYE_DOCKER_LOG_DIR=/var/log/siye-production
SIYE_LOG_GID=1000
MUSIC_API_LOG_FILE=/var/log/siye/music-api.log
MUSIC_API_ERROR_LOG_FILE=/var/log/siye/music-api-error.log
EASY_CHAT_LOG_FILE=/var/log/siye/socket.log
EASY_CHAT_ERROR_LOG_FILE=/var/log/siye/socket-error.log

# Successful GitHub Actions release. Keep this tag immutable.
MUSIC_API_IMAGE=siyesummer/music-api:0.0.1

# Phase 1 temporarily exposes music-api for local siyeWorld testing.
MUSIC_API_BIND_ADDRESS=0.0.0.0
MUSIC_API_HOST_PORT=3100

# Replace/add the actual local siyeWorld Origin before starting.
MUSIC_API_CORS_ALLOW_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://203.0.113.10:8090,https://music.siyes.cn

# Phase 2 uses the official MySQL image through the DaoCloud registry mirror.
MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0.39
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=siye_chat_release_drill
MYSQL_USER=siye_chat_release
MYSQL_PASSWORD=replace-with-a-long-random-app-password

# Successful GitHub Actions release. Keep this tag immutable.
LINUX_SERVER_IMAGE=siyesummer/linux-server:0.0.1

# Phase 2 temporarily exposes linux-server for local siyeWorld testing.
LINUX_SERVER_BIND_ADDRESS=0.0.0.0
LINUX_SERVER_HOST_PORT=8181
LINUX_SERVER_CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://203.0.113.10:8090,https://music.siyes.cn

# Read-only host log mount. Use the actual group id that owns /var/log/siye.
SIYE_LOG_DIR=/var/log/siye
SIYE_LOG_GID=1000

# Successful GitHub Actions release. Keep this tag immutable.
EASY_CHAT_IMAGE=siyesummer/easy-chat:0.0.1

# Phase 3 temporarily exposes easy-chat for local siyeWorld testing.
EASY_CHAT_BIND_ADDRESS=0.0.0.0
EASY_CHAT_HOST_PORT=3130
EASY_CHAT_CORS_ALLOW_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://203.0.113.10:8090,https://music.siyes.cn

# Phase 4 uses the official fixed Nginx image as the unified HTTP entry.
EDGE_NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
EDGE_NGINX_BIND_ADDRESS=0.0.0.0
EDGE_NGINX_HOST_PORT=8090

# Successful GitHub Actions release. Keep this tag immutable.
SIYE_WORLD_IMAGE=siyesummer/siye-world:0.0.1
